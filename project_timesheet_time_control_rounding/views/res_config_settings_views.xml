<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.timer.rounding</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_timesheet.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@name='time_encoding_setting_container']"
                position="inside"
            >
                <setting
                    id="timesheet_timer_rounding_setting"
                    company_dependent="1"
                    string="Timer Rounding"
                    help="Applied to the duration recorded when a timer is stopped. Hand-entered durations are not changed."
                >
                    <div class="mt16">
                        <div class="o_row">
                            <label
                                for="timesheet_timer_min_duration"
                                string="Minimum duration"
                                class="o_light_label"
                            />
                            <field
                                name="timesheet_timer_min_duration"
                                class="w-25 text-center"
                            />
                            <span>min</span>
                        </div>
                        <div class="o_row">
                            <label
                                for="timesheet_timer_rounding"
                                string="Round up to"
                                class="o_light_label"
                            />
                            <field
                                name="timesheet_timer_rounding"
                                class="w-25 text-center"
                            />
                            <span>min</span>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
