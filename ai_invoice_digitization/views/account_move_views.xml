<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_view_form" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit.ai.invoice.digitization</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="ai_has_pdf_attachment" invisible="1"/>
                <button name="action_ai_digitize" type="object" string="Digitalizar con IA"
                        class="btn-secondary"
                        invisible="move_type != 'in_invoice' or state != 'draft' or not ai_has_pdf_attachment"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group name="ai_digitization_group" string="Digitalización IA"
                       invisible="ai_digitization_state == 'pending' and not ai_raw_result">
                    <field name="ai_digitization_state" widget="badge"
                           decoration-muted="ai_digitization_state == 'pending'"
                           decoration-info="ai_digitization_state == 'processing'"
                           decoration-success="ai_digitization_state == 'done'"
                           decoration-danger="ai_digitization_state == 'error'"/>
                    <field name="ai_confidence" widget="progressbar" options="{'max_value': 1}" invisible="ai_digitization_state != 'done'"/>
                    <field name="ai_error_message" invisible="ai_digitization_state != 'error'"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
