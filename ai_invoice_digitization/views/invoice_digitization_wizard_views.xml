<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="invoice_digitization_wizard_view_form" model="ir.ui.view">
        <field name="name">ai.invoice.digitization.wizard.view.form</field>
        <field name="model">ai.invoice.digitization.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="move_id" invisible="1"/>
                <notebook>
                    <page string="Cabecera">
                        <group>
                            <field name="confidence" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="ref"/>
                            <field name="invoice_date"/>
                            <field name="invoice_date_due"/>
                            <field name="currency_id"/>
                            <field name="amount_untaxed" readonly="1"/>
                            <field name="amount_tax" readonly="1"/>
                            <field name="amount_total" readonly="1"/>
                        </group>
                    </page>
                    <page string="Líneas">
                        <field name="line_ids" editable="bottom">
                            <list>
                                <field name="product_id"/>
                                <field name="name"/>
                                <field name="quantity"/>
                                <field name="price_unit"/>
                                <field name="tax_ids" widget="many2many_tags"/>
                                <field name="price_subtotal" readonly="1"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_apply" type="object" string="Aplicar datos" class="btn-primary"/>
                    <button name="action_discard" type="object" string="Descartar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
