<odoo>
    <record id="project_task_timeline" model="ir.ui.view">
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project_timeline.project_task_timeline" />
        <field name="arch" type="xml">
            <field name="allocated_hours" position="after">
                <!-- Loaded even when the timeline is not grouped by project,
                     to know which milestones to draw. -->
                <field name="project_id" />
                <field name="milestone_id" />
                <field name="is_late_for_milestone" />
            </field>
        </field>
    </record>
</odoo>
