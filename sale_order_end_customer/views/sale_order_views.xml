<odoo>

    <record id="sale_order_end_customer_view_form" model="ir.ui.view">
        <field name="name">sale.order.form.end.customer</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="end_customer_id"
                       placeholder="Type to find a partner..."
                       readonly="state in ['cancel', 'sale']"/>
            </field>
        </field>
    </record>

    <record id="sale_order_end_customer_view_tree" model="ir.ui.view">
        <field name="name">sale.order.list.end.customer</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="client_order_ref" position="after">
                <field name="end_customer_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="sale_order_end_customer_view_search" model="ir.ui.view">
        <field name="name">sale.order.search.end.customer</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="end_customer_id" operator="child_of"/>
            </field>
            <filter name="customer" position="after">
                <filter name="group_by_end_customer"
                        string="Cliente Final"
                        context="{'group_by': 'end_customer_id'}"/>
            </filter>
        </field>
    </record>

</odoo>
