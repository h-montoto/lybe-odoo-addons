<odoo>
    <record id="view_partner_form_commission_partner" model="ir.ui.view">
        <field name="name">res.partner.form.commission.partner</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="commission_oca.view_partner_form_agent" />
        <field name="arch" type="xml">
            <page name="agent_information" position="after">
                <page
                    name="commission_partner_agents"
                    string="Agent commissions"
                    groups="commission_oca.group_commission_user"
                    invisible="parent_id or not commission_agent_ids"
                >
                    <field
                        name="commission_partner_agent_ids"
                        nolabel="1"
                        context="{'default_partner_id': id}"
                    >
                        <list editable="bottom">
                            <field name="allowed_agent_ids" column_invisible="1" />
                            <field
                                name="agent_id"
                                domain="[('id', 'in', allowed_agent_ids)]"
                            />
                            <field name="commission_id" />
                            <field name="commission_settlement_type" optional="show" />
                            <field name="commission_invoice_state" optional="hide" />
                        </list>
                    </field>
                    <p class="text-muted">
                        Agents listed here use this commission plan when selling to
                        this customer, instead of their own default plan. Agents
                        without a line keep their default plan.
                    </p>
                </page>
            </page>
            <page name="agent_information" position="inside">
                <separator string="Customer specific commissions" />
                <field name="agent_commission_partner_ids" nolabel="1" readonly="1">
                    <list>
                        <field name="partner_id" />
                        <field name="commission_id" />
                        <field name="commission_type" optional="hide" />
                        <field name="commission_invoice_state" optional="hide" />
                    </list>
                </field>
                <p class="text-muted">
                    Customers where this agent gets the commission plan listed
                    here, instead of its own default plan. They are defined on
                    each customer form.
                </p>
            </page>
        </field>
    </record>
</odoo>
