<odoo>
    <record id="sale_commission_partner_agent_view_list" model="ir.ui.view">
        <field name="name">sale.commission.partner.agent.list</field>
        <field name="model">sale.commission.partner.agent</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="allowed_agent_ids" column_invisible="1" />
                <field name="partner_id" optional="show" />
                <field name="agent_id" domain="[('id', 'in', allowed_agent_ids)]" />
                <field name="commission_id" />
                <field name="commission_type" optional="hide" />
                <field name="commission_settlement_type" optional="show" />
                <field name="commission_invoice_state" optional="hide" />
            </list>
        </field>
    </record>
    <record id="sale_commission_partner_agent_view_form" model="ir.ui.view">
        <field name="name">sale.commission.partner.agent.form</field>
        <field name="model">sale.commission.partner.agent</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="allowed_agent_ids" invisible="1" />
                            <field name="partner_id" />
                            <field
                                name="agent_id"
                                domain="[('id', 'in', allowed_agent_ids)]"
                            />
                        </group>
                        <group>
                            <field name="commission_id" />
                            <field name="commission_type" />
                            <field name="commission_settlement_type" />
                            <field name="commission_invoice_state" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sale_commission_partner_agent_action" model="ir.actions.act_window">
        <field name="name">Agent commissions per customer</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.commission.partner.agent</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define a specific commission plan for an agent on a given customer
            </p>
            <p>
                When an agent sells to this customer, the plan defined here is used
                instead of the agent's default commission plan.
            </p>
        </field>
    </record>
    <menuitem
        id="sale_commission_partner_agent_menu"
        parent="commission_oca.menu_commission"
        action="sale_commission_partner_agent_action"
        sequence="20"
    />
</odoo>
