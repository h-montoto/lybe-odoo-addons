<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        Las dos plantillas del core imprimen el nombre resolviéndolo contra la
        compañía del usuario que lanza el informe. Se cambia la expresión del
        span para que lo resuelva contra la compañía del propio movimiento: así
        el PDF de la compañía B muestra el nombre de B aunque lo imprima un
        usuario de A, y un albarán en lote con movimientos de dos compañías
        imprime cada línea con el nombre que le corresponde.

        Se usa position="attributes" en vez de position="replace", y priority=1
        en vez del 16 que Odoo da por defecto a un <template>, a propósito: otras
        personalizaciones de estos informes reemplazan la tabla o el tbody entero
        con prioridad 16, y una herencia que se aplicase después ya no encontraría
        el span. Con prioridad 1 esta herencia va primero y solo toca atributos,
        así que la instalación no falla aunque esas personalizaciones existan.
        Ver README/ROADMAP.
    -->
    <template
        id="report_picking_company_name"
        inherit_id="stock.report_picking"
        priority="1"
    >
        <xpath
            expr="//span[@t-field='move.product_id.display_name']"
            position="attributes"
        >
            <attribute name="t-field" />
            <attribute
                name="t-out"
            >move.product_id._get_display_name_for_company(move.company_id)</attribute>
        </xpath>
    </template>
    <template
        id="report_delivery_document_company_name"
        inherit_id="stock.report_delivery_document"
        priority="1"
    >
        <xpath expr="//span[@t-field='move.product_id']" position="attributes">
            <attribute name="t-field" />
            <attribute
                name="t-out"
            >move.product_id._get_display_name_for_company(move.company_id)</attribute>
        </xpath>
    </template>
</odoo>
