<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        Las dos plantillas del core imprimen el nombre resolviéndolo contra la
        compañía del usuario que lanza el informe. Se sustituyen por el helper,
        que lo resuelve contra la compañía del propio movimiento: así el PDF de
        la compañía B muestra el nombre de B aunque lo imprima un usuario de A,
        y un albarán en lote con movimientos de dos compañías imprime cada
        línea con el nombre que le corresponde.
    -->
    <template id="report_picking_company_name" inherit_id="stock.report_picking">
        <xpath expr="//span[@t-field='move.product_id.display_name']" position="replace">
            <span
                t-out="move.product_id._get_display_name_for_company(move.company_id)"
            >Customizable Desk</span>
        </xpath>
    </template>
    <template
        id="report_delivery_document_company_name"
        inherit_id="stock.report_delivery_document"
    >
        <xpath expr="//span[@t-field='move.product_id']" position="replace">
            <span
                t-out="move.product_id._get_display_name_for_company(move.company_id)"
            >Customizable Desk</span>
        </xpath>
    </template>
</odoo>
