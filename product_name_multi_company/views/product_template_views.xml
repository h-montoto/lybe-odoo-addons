<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.name.multi.company</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_general']" position="inside">
                <field name="name_company" groups="base.group_multi_company" />
                <!--
                    El campo editable escribe siempre en la compañía principal
                    del selector. El resumen muestra el nombre efectivo de
                    todas las compañías permitidas, para que con varias activas
                    a la vez no se edite a ciegas.
                -->
                <field
                    name="name_company_summary"
                    groups="base.group_multi_company"
                    invisible="not name_company_summary"
                />
            </xpath>
        </field>
    </record>
</odoo>
